{
  "datasets": [
    {
      "name": "a3a66b8a",
      "displayName": "application_kpis",
      "queryLines": [
        "SELECT\r\n",
        "    COUNT(*) AS application_count,\r\n",
        "    COUNT(DISTINCT customer_id) AS customer_count,\r\n",
        "    SUM(requested_amount) AS total_requested_amount,\r\n",
        "    SUM(\r\n",
        "        CASE WHEN is_approved THEN 1 ELSE 0 END\r\n",
        "    ) AS approved_application_count\r\n",
        "FROM workspace.fintech_jobs.customers_applications_gold;"
      ]
    },
    {
      "name": "935ab479",
      "displayName": "applications_by_state",
      "queryLines": [
        "SELECT\r\n",
        "    state,\r\n",
        "    application_count,\r\n",
        "    customer_count,\r\n",
        "    total_requested_amount,\r\n",
        "    approved_application_count\r\n",
        "FROM workspace.fintech_jobs.customers_applications_state_summary_gold\r\n",
        "ORDER BY state;"
      ]
    },
    {
      "name": "81d23b60",
      "displayName": "applications_by_status",
      "queryLines": [
        "SELECT\r\n",
        "    status,\r\n",
        "    COUNT(*) AS application_count,\r\n",
        "    SUM(requested_amount) AS total_requested_amount\r\n",
        "FROM workspace.fintech_jobs.customers_applications_gold\r\n",
        "GROUP BY status\r\n",
        "ORDER BY status;"
      ]
    },
    {
      "name": "533b850b",
      "displayName": "installments_by_payment_status",
      "queryLines": [
        "SELECT\r\n",
        "    payment_status,\r\n",
        "    COUNT(*) AS installment_count,\r\n",
        "    SUM(amount_due) AS total_amount_due\r\n",
        "FROM workspace.fintech_jobs.customers_installments_curated\r\n",
        "GROUP BY payment_status\r\n",
        "ORDER BY payment_status;"
      ]
    }
  ],
